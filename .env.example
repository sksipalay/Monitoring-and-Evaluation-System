# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional 32+ character HMAC signing key for server session tokens.
# If omitted, a persistent secret is automatically generated in .data/.session-secret.
SESSION_SECRET=""

