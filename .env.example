# Required in production for signing HttpOnly session tokens
SESSION_SECRET=

# Optional database storage directory (defaults to ./.data)
DATA_DIR=

# Session & Inactivity Policy (defaults: 12 hours TTL, 30 min idle timeout)
SESSION_TTL_HOURS=12
SESSION_INACTIVITY_MINUTES=30

# Set to true only if demo dataset seeding should be enabled in production
ALLOW_DEMO_SEED=false

# Optional comma-separated allowed origins for strict CSRF verification
CORS_ORIGIN=

# Optional bootstrap Super Administrator email override when initializing
BOOTSTRAP_ADMIN_EMAIL=